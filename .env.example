# CLOUDFLARE SETTINGS: required when using Cloudflare worker AI adapter.
# Set this to your Cloudflare Worker route, e.g. https://fuelverify-ai.<your-namespace>.workers.dev
VITE_CLOUDFLARE_WORKER_URL="https://MY_CLOUDFLARE_WORKER_URL"

# Cloudflare Worker secrets (wrangler *secret* names).
# CF_API_KEY: API token with access to AI model inference.
# CF_ACCOUNT_ID: Your Cloudflare account id.
# CF_AI_MODEL (optional): model name (e.g. gpt-4o-mini).
CF_API_KEY="MY_CF_API_KEY"
CF_ACCOUNT_ID="MY_CF_ACCOUNT_ID"
CF_AI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

